  m_EditorClassIdentifier: Assembly-CSharp::DreamWorld.Town.NpcTalk
  range: 2.3
  npcName: Jakeob
  lines:
  - hey! want a snack? we have a LOT of snacks.
  - the wolfpups and the mullens don't really get along. long story. like, four books
    long.
  - it's always warm by the fire. come sit.
